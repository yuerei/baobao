{
  "name": "baobao",
  "version": "1.2.1",
  "description": "A TypeScript Discord.js bot",
  "main": "src/BaoBao.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/BaoBao.ts",
    "start:built": "node dist/BaoBao.js",
    "dev": "tsx watch src/BaoBao.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:built": "node dist/deploy-commands.js",
    "clear": "tsx src/clear-commands.ts",
    "clear:built": "node dist/clear-commands.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3"
  }
}
